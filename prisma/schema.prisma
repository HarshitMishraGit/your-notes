// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  notes         Note[]
  sharedNotes   SharedNote[]
}

model Note {
  id          String      @id @default(cuid())
  title       String
  content     String      @db.Text // Using Text for potentially large markdown content
  contentType String      @default("markdown") // For future flexibility
  isPublic    Boolean     @default(false)
  tags        String[]    @default([])
  images      Image[]     // Relationship to uploaded images
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  sharedNotes SharedNote[]
}

model Image {
  id          String    @id @default(cuid())
  filename    String
  path        String    // Path to the image in MinIO
  mimeType    String
  size        Int
  noteId      String
  note        Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SharedNote {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
